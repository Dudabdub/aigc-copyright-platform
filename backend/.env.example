# ==================== 服务配置 ====================
PORT=3001
NODE_ENV=development

# ==================== 链模式 ====================
# 可选值：mock（模拟，无需区块链）| hardhat（本地链）| tianping（天平链）
CHAIN_MODE=mock

# 以下三项仅在 CHAIN_MODE=hardhat 时需要
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CONTRACT_ADDRESS=
PRIVATE_KEY=0xac0974bec39a17e36ba6a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ==================== IPFS 配置 ====================
IPFS_API_URL=http://127.0.0.1:5001
# 本地没有 IPFS 时设为 true，会跳过真实上传并返回 Mock CID
MOCK_IPFS=true

# ==================== 数据库与上传目录 ====================
DB_PATH=./data/copyright.db
UPLOAD_DIR=./uploads

# ==================== 天平链配置（正式接入时填写） ====================
TIANPING_GATEWAY=
TIANPING_APP_KEY=
TIANPING_APP_SECRET=
